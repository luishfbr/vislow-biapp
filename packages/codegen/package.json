{
  "name": "@vislow/codegen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traduz a arvore validada em fonte de um projeto pbiviz: visual.tsx, capabilities.json e pbiviz.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/rmrf.mjs dist .turbo"
  },
  "dependencies": {
    "@vislow/component-registry": "workspace:*",
    "@vislow/config-schema": "workspace:*"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "powerbi-visuals-api": "5.11.1"
  }
}

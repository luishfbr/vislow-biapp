{
  // Config de EMISSAO. Exclui testes; e o alvo das project references.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  // `test/` fica de fora da EMISSAO: e o que impede o `rootDir: ./src` de
  // reclamar de um arquivo fora dele, e o `template/` que ele importa de virar
  // `dist/`.
  "exclude": ["src/**/*.test.ts", "test/**/*"]
}

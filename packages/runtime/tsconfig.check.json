{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler"
  },
  // `test/` entra aqui, e nao no `tsconfig.json`: aquele e consumido pela
  // toolchain do pbiviz, que compila apenas `src/visual.tsx`.
  "include": ["src/**/*", "test/**/*"]
}

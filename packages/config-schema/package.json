{
  "name": "@vislow/config-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fonte unica da verdade do VisualConfig: schema, tipos, validacao, defaults e identidade",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./packaging": {
      "types": "./dist/packaging/index.d.ts",
      "default": "./dist/packaging/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "jszip": "3.10.1"
  }
}
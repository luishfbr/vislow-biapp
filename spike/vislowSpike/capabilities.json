{
    "dataRoles": [
        {
            "displayName": "Categoria",
            "name": "category",
            "kind": "Grouping"
        },
        {
            "displayName": "Valor",
            "name": "measure",
            "kind": "Measure"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": { "max": 1 },
                    "measure": { "max": 1 }
                }
            ],
            "categorical": {
                "categories": {
                    "for": { "in": "category" },
                    "dataReductionAlgorithm": { "top": { "count": 1000 } }
                },
                "values": {
                    "select": [{ "bind": { "to": "measure" } }]
                }
            }
        }
    ],
    "objects": {},
    "privileges": []
}
